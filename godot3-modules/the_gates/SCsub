#!/usr/bin/env python

import os

Import("env")
Import("env_modules")

env_tg = env_modules.Clone()

# cppzmq needs C++17 for std::optional-based recv results; Godot 3.6 builds
# the rest of the engine at gnu++14 and the two coexist per translation unit.
env_tg.Append(CXXFLAGS=["/std:c++17"] if env.msvc else ["-std=gnu++17"])
env_tg.Append(CPPDEFINES=["TG_RENDERER"])

# libzmq, cppzmq and flingfd are vendored in the Godot 4.5 fork. Both engines
# must speak the same wire protocol, so the Godot 3 renderer builds the same
# sources rather than vendoring a second copy that could drift.
MODULE_DIR = Dir(".").srcnode().abspath
REPO_ROOT = os.path.normpath(os.path.join(MODULE_DIR, "..", ".."))
THIRDPARTY = os.path.join(REPO_ROOT, "godot", "thirdparty")

if not os.path.isdir(THIRDPARTY):
    raise SystemExit(
        "the_gates: %s not found. Run `git submodule update --init godot` first." % THIRDPARTY
    )

zmq_dir = os.path.join(THIRDPARTY, "libzmq")
cppzmq_dir = os.path.join(THIRDPARTY, "cppzmq")
flingfd_dir = os.path.join(THIRDPARTY, "flingfd")
vulkan_include_dir = os.path.join(THIRDPARTY, "vulkan", "include")

env_tg.Prepend(CPPPATH=[cppzmq_dir, os.path.join(zmq_dir, "include"), flingfd_dir, vulkan_include_dir])
env_tg.Append(CPPDEFINES=["ZMQ_STATIC"])

# Drop WebSocket transports — they pull in gnutls/openssl and we only use ipc://.
zmq_sources_skip = {
    "ws_address.cpp",
    "ws_connecter.cpp",
    "ws_decoder.cpp",
    "ws_encoder.cpp",
    "ws_engine.cpp",
    "ws_listener.cpp",
    "wss_address.cpp",
    "wss_engine.cpp",
}

env_zmq = env_tg.Clone()
env_zmq.disable_warnings()
env_zmq.Prepend(
    CPPPATH=[
        os.path.join(zmq_dir, "src"),
        os.path.join(zmq_dir, "external", "sha1"),
    ]
)
# Upstream libzmq generates platform.hpp via autoconf or cmake; we vendor the
# source without that step. These macros are what cmake would emit per target,
# and match the Godot 4.5 fork's module SCsub.
env_zmq.Append(CPPDEFINES=["ZMQ_USE_BUILTIN_SHA1"])
if env["platform"] == "x11":
    env_zmq.Append(
        CPPDEFINES=[
            "ZMQ_HAVE_LINUX",
            ("ZMQ_CACHELINE_SIZE", 64),
            "ZMQ_IOTHREAD_POLLER_USE_EPOLL",
            "ZMQ_POLL_BASED_ON_POLL",
            "ZMQ_USE_CV_IMPL_PTHREADS",
            "ZMQ_HAVE_IPC",
            "ZMQ_HAVE_STRUCT_SOCKADDR_UN",
            "ZMQ_HAVE_EVENTFD",
            "ZMQ_HAVE_EVENTFD_CLOEXEC",
            "ZMQ_HAVE_O_CLOEXEC",
            "ZMQ_HAVE_SOCK_CLOEXEC",
            "ZMQ_HAVE_SO_KEEPALIVE",
            "ZMQ_HAVE_TCP_KEEPCNT",
            "ZMQ_HAVE_TCP_KEEPIDLE",
            "ZMQ_HAVE_TCP_KEEPINTVL",
            "ZMQ_HAVE_UIO",
            "ZMQ_HAVE_IFADDRS",
            "ZMQ_HAVE_NOEXCEPT",
            "ZMQ_HAVE_PTHREAD_SETNAME_2",
            "ZMQ_HAVE_PTHREAD_SET_AFFINITY",
            "ZMQ_HAVE_STRLCPY",
            ("HAVE_POSIX_MEMALIGN", 1),
            "HAVE_STRNLEN",
            "HAVE_CLOCK_GETTIME",
            "HAVE_MKDTEMP",
            "HAVE_FORK",
            "HAVE_ACCEPT4",
            "_GNU_SOURCE",
        ]
    )
elif env["platform"] == "windows":
    env_zmq.Prepend(CPPPATH=[os.path.join(zmq_dir, "external", "wepoll")])
    if not env.msvc:
        # libzmq reaches AF_UNIX through <afunix.h> only under _MSC_VER.
        env_zmq.Prepend(CPPPATH=[os.path.join(MODULE_DIR, "thirdparty_compat", "mingw")])
    env_zmq.Append(
        CPPDEFINES=[
            "ZMQ_HAVE_WINDOWS",
            "ZMQ_IOTHREAD_POLLER_USE_EPOLL",
            "ZMQ_POLL_BASED_ON_POLL",
            "ZMQ_USE_CV_IMPL_WIN32API",
            "ZMQ_HAVE_IPC",
            "ZMQ_HAVE_STRUCT_SOCKADDR_UN",
            "HAVE_STRNLEN",
            ("FD_SETSIZE", 16384),
            "_CRT_SECURE_NO_WARNINGS",
            "_WINSOCK_DEPRECATED_NO_WARNINGS",
        ]
    )
    env.Append(LIBS=["rpcrt4", "shell32"])
elif env["platform"] == "osx":
    env_zmq.Append(
        CPPDEFINES=[
            "ZMQ_HAVE_OSX",
            ("ZMQ_CACHELINE_SIZE", 64),
            "ZMQ_HAVE_STRLCPY",
            "ZMQ_IOTHREAD_POLLER_USE_KQUEUE",
            "ZMQ_POLL_BASED_ON_POLL",
            "ZMQ_USE_CV_IMPL_PTHREADS",
            "ZMQ_HAVE_IPC",
            "ZMQ_HAVE_STRUCT_SOCKADDR_UN",
            "ZMQ_HAVE_UIO",
            "ZMQ_HAVE_IFADDRS",
            "ZMQ_HAVE_KQUEUE",
            "ZMQ_HAVE_NOEXCEPT",
            "HAVE_POSIX_MEMALIGN",
            "HAVE_STRNLEN",
            "HAVE_CLOCK_GETTIME",
            "HAVE_MKDTEMP",
            "HAVE_FORK",
        ]
    )
    env.Append(LINKFLAGS=["-framework", "IOSurface"])

# Sources live outside the SCons source root, so each object needs an explicit
# target under the module's build dir; a bare source path would drop the .o
# next to the vendored source in the godot/ submodule.
thirdparty_obj = []
for src in sorted(Glob(os.path.join(zmq_dir, "src", "*.cpp"), strings=True)):
    name = os.path.basename(src)
    if name in zmq_sources_skip:
        continue
    thirdparty_obj.append(env_zmq.Object(target="zmq/" + name[:-4], source=src))

thirdparty_obj.append(
    env_zmq.Object(target="zmq/sha1", source=os.path.join(zmq_dir, "external", "sha1", "sha1.c"))
)
if env["platform"] == "windows":
    thirdparty_obj.append(
        env_zmq.Object(target="zmq/wepoll", source=os.path.join(zmq_dir, "external", "wepoll", "wepoll.c"))
    )

if env["platform"] == "x11":
    env_flingfd = env_tg.Clone()
    env_flingfd.disable_warnings()
    thirdparty_obj.append(
        env_flingfd.Object(target="flingfd/flingfd", source=os.path.join(flingfd_dir, "flingfd.c"))
    )

env.modules_sources += thirdparty_obj

module_obj = []
env_tg.add_source_files(module_obj, "*.cpp")
env_tg.add_source_files(module_obj, "ipc/*.cpp")
if env["platform"] == "x11":
    # The broker's wire protocol, framing and CIDR policy compile straight out of
    # the 4.5 fork's module, like libzmq, so both ends share one source; the
    # compat headers map the Godot 4 names those files use onto Godot 3's.
    fork_network_dir = os.path.join(REPO_ROOT, "godot", "modules", "the_gates", "network")
    compat_dir = os.path.join(MODULE_DIR, "thirdparty_compat", "godot4")
    env_net = env_tg.Clone()
    env_net.Prepend(CPPPATH=[compat_dir, fork_network_dir])
    env_net.Append(CXXFLAGS=["-include", os.path.join(compat_dir, "godot4_compat.h")])
    for name in ["broker_protocol", "fd_passing_unix", "cidr_policy"]:
        module_obj.append(env_net.Object(target="network/fork_" + name, source=os.path.join(fork_network_dir, name + ".cpp")))
    env_net.add_source_files(module_obj, "network/*.cpp")

    # The Linux lockdown (landlock, capability drop, seccomp) is the 4.x fork's,
    # built from its sources and the same Chromium sandbox subset its SCsub lists,
    # so the renderer policy cannot drift between the two engines.
    fork_sandbox_dir = os.path.join(REPO_ROOT, "godot", "modules", "the_gates", "sandbox", "linux")
    chromium_dir = os.path.join(THIRDPARTY, "chromium-sandbox")
    chromium_include = [
        os.path.join(chromium_dir, "chromium-shim"),
        chromium_dir,
        os.path.join(chromium_dir, "gen"),
        os.path.join(chromium_dir, "base", "allocator", "partition_allocator", "src"),
        os.path.join(chromium_dir, "gen", "base", "allocator", "partition_allocator", "src"),
        os.path.join(chromium_dir, "third_party", "abseil-cpp"),
    ]

    def fork_chromium_sources():
        import ast

        wanted = ["sandbox_linux_sources", "base_sources", "chromium_shim_sources", "abseil_sources"]
        tree = ast.parse(open(os.path.join(fork_sandbox_dir, "SCsub")).read())
        lists = {}
        for node in tree.body:
            if isinstance(node, ast.Assign) and isinstance(node.targets[0], ast.Name) and node.targets[0].id in wanted:
                lists[node.targets[0].id] = ast.literal_eval(node.value)
        missing = [name for name in wanted if name not in lists]
        if missing:
            raise SystemExit("the_gates: %s not found in the fork's sandbox/linux/SCsub" % ", ".join(missing))
        return [path for name in wanted for path in lists[name]]

    def cxx20(environment):
        environment["CXXFLAGS"] = [f for f in environment["CXXFLAGS"] if not str(f).startswith("-std=")]
        environment.Append(CXXFLAGS=["-std=gnu++20"])

    env_chromium = env_tg.Clone()
    env_chromium.disable_warnings()
    cxx20(env_chromium)
    env_chromium.Prepend(CPPPATH=chromium_include)
    env_chromium.Prepend(
        CPPDEFINES=[
            "NDEBUG",
            "_GNU_SOURCE",
            ("_FILE_OFFSET_BITS", 64),
            ("_LARGEFILE_SOURCE", 1),
            ("_LARGEFILE64_SOURCE", 1),
            "NVALGRIND",
            ("DYNAMIC_ANNOTATIONS_ENABLED", 0),
            "MOZ_SANDBOX",
            "CHROMIUM_SANDBOX_BUILD",
        ]
    )
    chromium_obj = []
    for path in fork_chromium_sources():
        stem = os.path.splitext(path)[0].replace("/", "_")
        chromium_obj.append(env_chromium.Object(target="chromium/" + stem, source=os.path.join(chromium_dir, path)))
    env.modules_sources += chromium_obj

    env_lockdown = env_net.Clone()
    cxx20(env_lockdown)
    env_lockdown.Prepend(CPPPATH=chromium_include + [fork_sandbox_dir])
    env_lockdown.Append(CPPDEFINES=["LINUXBSD_ENABLED"])

    # Godot 3's String spells is_empty() as empty(); the one call is rewritten at
    # build time instead of keeping a copy of the lockdown policy here.
    def godot3_lockdown(target, source, env):
        text = open(str(source[0])).read()
        if text.count("p_rw_dir.is_empty()") != 1:
            raise SystemExit("the_gates: fork lockdown.cpp changed; update the Godot 3 rewrite in SCsub")
        with open(str(target[0]), "w") as out:
            out.write(text.replace("p_rw_dir.is_empty()", "p_rw_dir.empty()"))

    # Chromium only supports clang; GCC rejects its protected_memory section attributes.
    for chromium_env in (env_chromium, env_lockdown):
        chromium_env["CC"] = "clang"
        chromium_env["CXX"] = "clang++"

    lockdown_cpp = env_lockdown.Command("gen/fork_lockdown.cpp", os.path.join(fork_sandbox_dir, "lockdown.cpp"), godot3_lockdown)
    module_obj.append(env_lockdown.Object(target="sandbox/fork_lockdown", source=lockdown_cpp))
    module_obj.append(env_lockdown.Object(target="sandbox/fork_seccomp_policy", source=os.path.join(fork_sandbox_dir, "seccomp_policy.cpp")))
    env_lockdown.add_source_files(module_obj, "sandbox/lockdown_engage.cpp")

renderer_sources = Glob("renderer/*.cpp")
if env["platform"] == "osx":
    # macOS binds an IOSurface and never has to measure a Vulkan allocation.
    renderer_sources = [f for f in renderer_sources if f.name != "vulkan_memory_probe.cpp"]
env_tg.add_source_files(module_obj, renderer_sources)
env.modules_sources += module_obj

env.Depends(module_obj, thirdparty_obj)
